rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if true;
    }

    match /flashcards/{flashcardId} {
      allow read: if true;
      allow write: if true;
    }

    match /progress/{progressId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
